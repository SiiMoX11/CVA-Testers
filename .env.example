# Copiez ce fichier en .env pour un test local, ou définissez ces variables dans
# l'onglet « Environment » du service Render. Ne jamais publier .env ni ces valeurs.

# ----- Stockage des fichiers (imageries, documents, CRO, urgences) : Cloudflare R2 -----
# Les quatre variables suivantes activent automatiquement le stockage R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optionnel : endpoint S3 explicite (par défaut https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT_URL=
# Optionnel : préfixe commun des clés dans le bucket (ex. "cva/" pour partager un bucket)
# R2_PREFIX=
# Optionnel : forcer le mode ("r2" ou "local"). Par défaut : r2 si les variables R2 sont présentes.
# CVA_STORAGE=r2
# Taille max. du cache local des fichiers lus depuis R2 (Mo). Défaut 512.
# CVA_STORAGE_CACHE_MB=512

# ----- Base de données SQLite -----
# Sur Render, un disque persistant est fortement recommandé (ex. monté sur /var/data) :
#   CVA_DB=/var/data/cva.db
#   CVA_UPLOADS=/var/data/uploads
# Sans disque persistant, la base est restaurée automatiquement depuis la sauvegarde R2
# (_backups/cva.db) à chaque démarrage ; une sauvegarde est envoyée vers R2 toutes les
# CVA_DB_BACKUP_MINUTES minutes et après chaque modification importante.
CVA_DB=/var/data/cva.db
CVA_UPLOADS=/var/data/uploads
CVA_DB_BACKUP_R2=1
CVA_DB_BACKUP_MINUTES=5

# ----- Sécurité -----
# Mot de passe initial du compte admin (utilisé uniquement au tout premier lancement, base vide).
# Sans cette variable, un mot de passe aléatoire est affiché une seule fois dans les logs.
CVA_ADMIN_PASSWORD=
# 1 = l'application est derrière un proxy HTTPS (Render, Nginx, Caddy). Détecté automatiquement sur Render.
CVA_BEHIND_PROXY=1
# Durée des sessions
CVA_SESSION_IDLE_HOURS=12
CVA_SESSION_MAX_DAYS=7

# Port local (Render fournit PORT automatiquement)
PORT=8000
